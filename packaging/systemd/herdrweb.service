[Unit]
Description=Herdr Web Bridge Daemon
Documentation=https://github.com/sarathsp06/herdrweb
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/herdrweb -addr 127.0.0.1:7331 -log-file %h/.config/herdr/herdrweb.log
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
